<Project Sdk="Gsharp.NET.Sdk/0.3.633">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpTui</RootNamespace>
    <AssemblyName>tuitool</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/**/*.gs" />
    <Compile Remove="mine/**/*.gs" />
    <Compile Remove="tools/**/*.gs" />
    <Compile Remove="agent-testing/**/*.gs" />
    <Compile Remove="archive/**/*.gs" />
    <ProjectReference Include="SharpTui.Framework.gsproj" />
  </ItemGroup>

</Project>
