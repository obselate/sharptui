<Project Sdk="Gsharp.NET.Sdk/0.5.26">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpTui</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <!-- Drops ICU: 66.8 MB RSS to 37.9 MB, measured. Grapheme clustering is
         runtime data, not ICU, so the width and cluster checks still pass. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="examples/**/*.gs" />
    <Compile Remove="tools/**/*.gs" />
    <Compile Remove="agent-testing/**/*.gs" />
    <Compile Remove="showcases/**/*.gs" />
    <Compile Remove="bonsai-apps/**/*.gs" />
    <Compile Remove="archive/**/*.gs" />
    <ProjectReference Include="vendor/Yoga.Net/src/Yoga.Net/Yoga.Net.csproj" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

</Project>
