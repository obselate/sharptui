<Project Sdk="Gsharp.NET.Sdk/0.3.633">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpTui</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/Main.gs" />
    <Compile Remove="src/Checks/**/*.gs" />
    <Compile Remove="examples/**/*.gs" />
    <Compile Remove="mine/**/*.gs" />
    <Compile Remove="tools/**/*.gs" />
    <Compile Remove="agent-testing/**/*.gs" />
    <Compile Remove="archive/**/*.gs" />
    <ProjectReference Include="vendor/Yoga.Net/src/Yoga.Net/Yoga.Net.csproj" />
  </ItemGroup>

  <!-- The G# SDK writes the XML doc file to obj only; feed it to the copy pipeline. -->
  <Target Name="_PopulateSharpTuiDocFileItems"
          AfterTargets="CoreCompile"
          Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
    </ItemGroup>
  </Target>

</Project>
